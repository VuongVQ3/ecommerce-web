# Frontend build-time settings. Vite only exposes variables prefixed with VITE_ to the browser,
# so never put secrets here. Development values live in .env.development; for a production build,
# set these in the hosting provider or in .env.production.

# Cloudflare Turnstile site key of a managed/invisible widget for your domain (registration anti-bot).
VITE_TURNSTILE_SITE_KEY=

# Only when the backend is on another domain than the frontend, e.g. https://api.hatlanh.vn
VITE_API_URL=
