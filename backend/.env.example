# Copy to backend/.env for local development. Never commit the real .env.
# In production, set these as real environment variables on the host instead.

# --- Required ---
# Random string of at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Cloudflare Turnstile secret key (anti-bot on registration). The value below is Cloudflare's public TEST secret
# that always passes: fine for development, replace with your real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Database (defaults match docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/nutshop
DB_USERNAME=nutshop
DB_PASSWORD=

# --- Frontend / cookies ---
# The only origin allowed by CORS (credentials enabled)
FRONTEND_URL=http://localhost:5173
# Lax for local dev (Vite proxies /api, same site). None when frontend and backend are on different sites.
COOKIE_SAME_SITE=Lax
# Keep true. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true

# --- Email (password reset) ---
# Resend API key. Empty = emails (with reset links) are only written to the log: development only!
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Hat Lanh <no-reply@yourdomain.vn>
MAIL_FROM=Hat Lanh <onboarding@resend.dev>

# --- Optional ---
# Google Sign-In: OAuth client ID (Web application). Empty = Google button hidden.
GOOGLE_CLIENT_ID=
# "framework" only behind a trusted reverse proxy that sets X-Forwarded-For
FORWARD_HEADERS_STRATEGY=none
