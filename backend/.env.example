# Copy to backend/.env for local development. Never commit the real .env.
# In production, set these as real environment variables on the host instead.

# --- Required ---
# Random string of at least 32 characters, e.g. `openssl rand -base64 48`
JWT_SECRET=

# Cloudflare Turnstile secret key (anti-bot on registration). The value below is Cloudflare's public TEST secret
# that always passes: fine for development, replace with your real secret in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Database (defaults match docker-compose.yml) ---
DB_URL=jdbc:postgresql://localhost:5432/nutshop
DB_USERNAME=nutshop
DB_PASSWORD=

# --- Frontend / cookies ---
# The only origin allowed by CORS (credentials enabled)
FRONTEND_URL=http://localhost:5173
# Lax for local dev (Vite proxies /api, same site). None when frontend and backend are on different sites.
COOKIE_SAME_SITE=Lax
# Keep true. Browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true

# --- Email (password reset) ---
# Resend API key. Empty = emails (with reset links) are only written to the log: development only!
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. Hat Lanh <no-reply@yourdomain.vn>
MAIL_FROM=Hat Lanh <onboarding@resend.dev>

# --- Optional ---
# Google Sign-In: OAuth client ID (Web application). Empty = Google button hidden.
GOOGLE_CLIENT_ID=
# "framework" only behind a trusted reverse proxy that sets X-Forwarded-For
FORWARD_HEADERS_STRATEGY=none

# Back office: email of an already registered account to promote to ADMIN at startup
ADMIN_EMAIL=
# Product images (Cloudinary console > API Keys): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Public base URL for canonical links, Open Graph, robots.txt and the sitemap (defaults to FRONTEND_URL).
# Change it when moving to a custom domain, e.g. https://hatlanh.vn
SITE_URL=
# Business details shown in the footer and on /lien-he. Leave a field empty to hide it.
BUSINESS_OWNER_NAME=
BUSINESS_ADDRESS=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_HOTLINE=
BUSINESS_EMAIL=
# Link to the shop's notification on online.gov.vn (Bộ Công Thương), must start with https://
BUSINESS_MOIT_URL=
